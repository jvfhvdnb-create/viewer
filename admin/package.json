{
  "name": "imageboard-admin",
  "version": "1.0.2",
  "description": "ImageBoard LAN Admin",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron electron/main.cjs\"",
    "build": "vite build",
    "start": "electron electron/main.cjs",
    "dist:msi": "npm run build && electron-builder --win msi",
    "dist": "npm run build && electron-builder --win msi nsis portable"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "37.10.3",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.2",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.almustafa.imageboard.admin",
    "productName": "ImageBoard Admin",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": "msi",
      "icon": "build/icon.ico"
    },
    "msi": {
      "artifactName": "ImageBoard-Admin-${version}-x64.${ext}",
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "warningsAsErrors": false,
      "upgradeCode": "A7C2B9D4-8A34-4F21-9E6A-5B0A4D6F1C22"
    }
  },
  "author": "Al-Mustafa"
}
